{
  "name": "@local/dsh-prompt-optimizor",
  "version": "0.1.0",
  "type": "module",
  "description": "Prompt Optimizor — polish the composer draft with a configurable model, and switch back to the original with one more click.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grampusworld/dsh-prompt-optimizor.git"
  },
  "homepage": "https://github.com/Grampusworld/dsh-prompt-optimizor#readme",
  "bugs": {
    "url": "https://github.com/Grampusworld/dsh-prompt-optimizor/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "assets/*",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "optimizer",
    "polish"
  ]
}
